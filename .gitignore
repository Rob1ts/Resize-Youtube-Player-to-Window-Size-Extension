# Dependencies
node_modules/

# CRX signing key -- NEVER commit. Anyone holding this private key can publish
# updates that impersonate the extension. Keep a backup outside the repository.
keys/
*.pem
*.key
*.p12

# Built packages -- published as GitHub release assets, not committed source.
# Regenerate with: npm run build && npm run crx
release/
*.crx
*.xpi
*.zip

# Transient build/verification files
.verify-payload/
.crx-payload.zip

# Stale package backups
*.bak

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
